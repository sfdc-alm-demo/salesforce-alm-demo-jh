    <description>WHAT: Quick Quote flow to create a Quote from either the Account or Opportunity record
WHEN: Oct 2025
WHO: Derrick Vuong</description>
    <environments>Default</environments>
    <formulas>
        <description>Stores the Opportunity name. If an Opportunity exists this will be overwritten, otherwise uses default Opportunity Name value</description>
        <name>OpportunityName</name>
        <dataType>String</dataType>
        <expression>IF(BEGINS({!recordId}, &apos;006&apos;), {!Get_Opportunity_Record.Name}, {!Get_Account_Record.Name} + &quot; - New Opportunity - &quot; + TEXT(TODAY()))</expression>
    </formulas>
    <formulas>
        <description>Calculate the Quote expiration date 1 month from today. If it lands on a weekend then use the Monday after</description>
        <name>QuoteExpirationDate</name>
        <dataType>Date</dataType>
        <expression>IF(WEEKDAY(ADDMONTHS(TODAY(), 1)) = 1, ADDMONTHS(TODAY(), 1) + 1, 
(IF(WEEKDAY(ADDMONTHS(TODAY(), 1)) = 7, ADDMONTHS(TODAY(), 1) + 2, 
ADDMONTHS(TODAY(), 1))))</expression>
    </formulas>
    <formulas>
        <name>QuoteName</name>
        <dataType>String</dataType>
        <expression>{!OpportunityName} + &quot; - Quick Quote&quot;</expression>
    </formulas>
    <formulas>
        <name>QuoteStartDate</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <interviewLabel>RC Quick Quote {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RC Quick Quote</label>
